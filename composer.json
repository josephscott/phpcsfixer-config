{
	"name": "josephscott/phpcsfixer-config",
	"type": "library",
	"license": "MIT",
	"require": {
		"php": ">=8.1",
		"friendsofphp/php-cs-fixer": "3.95.27"
	},
	"require-dev": {
		"phpstan/phpstan": "2.3.1",
		"pestphp/pest": "5.3.1"
	},
	"autoload": {
		"classmap": [
			"src/josephscott/phpcsfixer-config.php"
		]
	},
	"config": {
		"classmap-authoritative": true,
		"optimize-autoloader": true,
		"allow-plugins": false
	}
}
